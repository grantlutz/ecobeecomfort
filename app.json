{
  "id": "com.dellarciprete.ecobee",
  "version": "1.1.0",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "runtime": "python",
  "pythonVersion": "3.13",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "ecobee Comfort"
  },
  "description": {
    "en": "Switch your ecobee between Home, Away, and Sleep — right from Homey."
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "author": {
    "name": "John Dell'Arciprete",
    "email": "johndellarciprete@gmail.com"
  },
  "homepage": "https://github.com/johndellarciprete/ecobeecomfort",
  "source": "https://github.com/johndellarciprete/ecobeecomfort",
  "support": "https://github.com/johndellarciprete/ecobeecomfort/issues",
  "bugs": {
    "url": "https://github.com/johndellarciprete/ecobeecomfort/issues"
  },
  "license": "MIT",
  "brandColor": "#1B7F79",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "capabilities": {
    "ecobee_comfort": {
      "type": "enum",
      "title": {
        "en": "Comfort Profile"
      },
      "uiComponent": "picker",
      "icon": "/assets/icons/comfort.svg",
      "getable": true,
      "setable": true,
      "insights": true,
      "values": [
        {
          "id": "schedule",
          "title": {
            "en": "Schedule"
          }
        },
        {
          "id": "home",
          "title": {
            "en": "Home"
          }
        },
        {
          "id": "away",
          "title": {
            "en": "Away"
          }
        },
        {
          "id": "sleep",
          "title": {
            "en": "Sleep"
          }
        },
        {
          "id": "custom",
          "title": {
            "en": "Custom"
          }
        }
      ]
    },
    "ecobee_hold_status": {
      "type": "enum",
      "title": {
        "en": "Hold"
      },
      "uiComponent": "sensor",
      "icon": "/assets/icons/hold.svg",
      "getable": true,
      "setable": false,
      "insights": true,
      "values": [
        {
          "id": "schedule",
          "title": {
            "en": "Following schedule"
          }
        },
        {
          "id": "hold",
          "title": {
            "en": "Holding"
          }
        },
        {
          "id": "vacation",
          "title": {
            "en": "Vacation"
          }
        }
      ]
    },
    "ecobee_fan_mode": {
      "type": "enum",
      "title": {
        "en": "Fan"
      },
      "uiComponent": "picker",
      "icon": "/assets/icons/fan.svg",
      "getable": true,
      "setable": true,
      "insights": true,
      "values": [
        {
          "id": "auto",
          "title": {
            "en": "Auto"
          }
        },
        {
          "id": "on",
          "title": {
            "en": "On"
          }
        }
      ]
    }
  },
  "drivers": [
    {
      "id": "thermostat",
      "name": {
        "en": "ecobee Thermostat"
      },
      "class": "thermostat",
      "capabilities": [
        "measure_temperature",
        "measure_humidity",
        "target_temperature",
        "thermostat_mode",
        "ecobee_comfort",
        "ecobee_fan_mode",
        "ecobee_hold_status"
      ],
      "capabilitiesOptions": {
        "thermostat_mode": {
          "insights": true,
          "values": [
            {
              "id": "off",
              "title": {
                "en": "Off"
              }
            },
            {
              "id": "heat",
              "title": {
                "en": "Heat"
              }
            },
            {
              "id": "cool",
              "title": {
                "en": "Cool"
              }
            },
            {
              "id": "auto",
              "title": {
                "en": "Auto"
              }
            },
            {
              "id": "aux",
              "title": {
                "en": "Aux heat"
              }
            }
          ]
        },
        "target_temperature": {
          "min": 5,
          "max": 35,
          "step": 0.5,
          "decimals": 0,
          "insights": true
        },
        "measure_temperature": {
          "decimals": 0,
          "insights": true
        },
        "measure_humidity": {
          "insights": true
        }
      },
      "platforms": [
        "local"
      ],
      "images": {
        "small": "/drivers/thermostat/assets/images/small.png",
        "large": "/drivers/thermostat/assets/images/large.png",
        "xlarge": "/drivers/thermostat/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "start"
        }
      ]
    },
    {
      "id": "sensor",
      "name": {
        "en": "ecobee Room Sensor"
      },
      "class": "sensor",
      "capabilities": [
        "measure_temperature",
        "alarm_motion",
        "measure_humidity"
      ],
      "capabilitiesOptions": {
        "measure_temperature": {
          "decimals": 0,
          "insights": true
        },
        "measure_humidity": {
          "insights": true
        },
        "alarm_motion": {
          "insights": true
        }
      },
      "platforms": [
        "local"
      ],
      "images": {
        "small": "/drivers/sensor/assets/images/small.png",
        "large": "/drivers/sensor/assets/images/large.png",
        "xlarge": "/drivers/sensor/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "start"
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "comfort_changed",
        "title": {
          "en": "Comfort profile changed"
        },
        "titleFormatted": {
          "en": "Comfort profile changed to [[profile]]"
        },
        "tokens": [
          {
            "name": "profile",
            "type": "string",
            "title": {
              "en": "Profile"
            },
            "example": "away"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "comfort_profile_is",
        "title": {
          "en": "Comfort profile !{{is|is not}}"
        },
        "titleFormatted": {
          "en": "Comfort profile !{{is|is not}} [[profile]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "text",
            "name": "profile",
            "title": {
              "en": "Profile"
            },
            "placeholder": {
              "en": "home, away, sleep or a custom profile"
            }
          }
        ]
      },
      {
        "id": "aux_heat_only_is",
        "title": {
          "en": "Mode !{{is|is not}} aux heat only"
        },
        "hint": {
          "en": "True when the thermostat's mode is aux heat only (heating with its auxiliary/backup heat alone). Reads the mode fresh from ecobee."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_comfort_profile",
        "title": {
          "en": "Set comfort profile"
        },
        "titleFormatted": {
          "en": "Set comfort profile to [[profile]] ([[hold_type]])"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "dropdown",
            "name": "profile",
            "title": {
              "en": "Profile"
            },
            "values": [
              {
                "id": "home",
                "title": {
                  "en": "Home"
                }
              },
              {
                "id": "away",
                "title": {
                  "en": "Away"
                }
              },
              {
                "id": "sleep",
                "title": {
                  "en": "Sleep"
                }
              },
              {
                "id": "schedule",
                "title": {
                  "en": "Schedule (resume program)"
                }
              }
            ]
          },
          {
            "type": "dropdown",
            "name": "hold_type",
            "title": {
              "en": "Hold until"
            },
            "values": [
              {
                "id": "indefinite",
                "title": {
                  "en": "I change it again"
                }
              },
              {
                "id": "nextTransition",
                "title": {
                  "en": "The next scheduled change"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_comfort_profile_named",
        "title": {
          "en": "Set comfort profile by name"
        },
        "titleFormatted": {
          "en": "Set comfort profile to [[name]] ([[hold_type]])"
        },
        "hint": {
          "en": "Use this for custom comfort profiles you created in the ecobee app. Type the profile's name exactly as it appears there."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "text",
            "name": "name",
            "title": {
              "en": "Profile name"
            },
            "placeholder": {
              "en": "e.g. Movie Night"
            }
          },
          {
            "type": "dropdown",
            "name": "hold_type",
            "title": {
              "en": "Hold until"
            },
            "values": [
              {
                "id": "indefinite",
                "title": {
                  "en": "I change it again"
                }
              },
              {
                "id": "nextTransition",
                "title": {
                  "en": "The next scheduled change"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "resume_schedule",
        "title": {
          "en": "Resume the schedule"
        },
        "hint": {
          "en": "Clears any hold and hands the thermostat back to its own program."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      },
      {
        "id": "set_fan_mode",
        "title": {
          "en": "Set fan mode"
        },
        "titleFormatted": {
          "en": "Set fan mode to [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Fan mode"
            },
            "values": [
              {
                "id": "auto",
                "title": {
                  "en": "Auto"
                }
              },
              {
                "id": "on",
                "title": {
                  "en": "On"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_aux_heat_only",
        "title": {
          "en": "Set aux heat only"
        },
        "hint": {
          "en": "Heats with the auxiliary (backup) heat alone, e.g. a gas or propane furnace, and remembers the current mode so 'Restore mode from before aux heat' can put it back. Does nothing if the thermostat is already in aux heat only."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      },
      {
        "id": "restore_from_aux_heat",
        "title": {
          "en": "Restore mode from before aux heat"
        },
        "hint": {
          "en": "Puts back the mode saved by 'Set aux heat only' (Heat if nothing was saved). Leaves the thermostat alone if its mode was changed in the meantime."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      }
    ]
  },
  "pythonPackages": [
    "aiohttp",
    "certifi"
  ]
}